# ============================================================
# PIECES BY P  |  Environment config
# Fill these in at the account-setup meeting. The app reads ONLY
# from here, so linking Polly's accounts is pasting values, not
# editing code. Keep this file private (it holds secrets).
# ============================================================

# ---- Supabase (database + admin login + photo storage) ----
# From your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=            # e.g. https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # public "anon" key (safe in the browser)
SUPABASE_SERVICE_ROLE_KEY=           # SECRET, server-only, never exposed to the browser

# ---- Stripe (card payments) ----
# Build and test with the TEST keys (fake cards, no real money).
# Swap to the LIVE keys at launch once her account is verified.
STRIPE_SECRET_KEY=                   # sk_test_... while building, sk_live_... at launch
STRIPE_WEBHOOK_SECRET=               # whsec_..., created when you add the webhook in Stripe

# ---- Email (Brevo) ----
# Leave blank and nothing breaks: the shop runs, orders save, only the
# emails don't send. Fill both in to switch on order confirmations, the
# new-order alert to Polly, payment-received, shipped, contact auto-reply,
# and the Venmo reminder button.
# Brevo (brevo.com) is free for 300 emails/day and verifies a domain with
# TXT/CNAME records only — which is all Wix DNS can do.
BREVO_API_KEY=                       # SECRET, from Brevo > SMTP & API > API keys
EMAIL_FROM=                          # Pieces by P <orders@piecesbyp.com>

# ---- Admin access ----
# Polly's login runs through Supabase Auth. This is the only email
# allowed into the /admin area (the orders page + product editor).
ADMIN_EMAIL=                         # polly's email

# ---- Site ----
NEXT_PUBLIC_SITE_URL=                # the Netlify URL while testing, https://piecesbyp.com at launch
